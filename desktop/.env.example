# Auth backend public URL (your Vercel deployment)
AUTH_BACKEND_URL=https://your-backend.vercel.app

# GitHub OAuth App — client ID only (secret stays on the backend server)
GITHUB_CLIENT_ID=

# LLM API — stored in memory during dev; Phase 1.4 moves to electron.safeStorage
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Local ingest endpoint port (default 47821)
INGEST_PORT=47821
